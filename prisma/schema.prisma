generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model books {
  id                BigInt             @id @default(autoincrement())
  title             String             @db.VarChar(255)
  author            String             @db.VarChar(255)
  pdf_url           String?            @db.VarChar(255)
  total_pages       Int?               @default(0)
  source_type       String             @default("public_domain") @db.VarChar(255)
  is_published      Boolean            @default(false)
  processing_status String?            @default("pending") @db.VarChar(255)
  processing_cost   Decimal?           @db.Decimal(10, 4)
  processing_error  String?
  inserted_at       DateTime           @db.Timestamp(0)
  updated_at        DateTime           @db.Timestamp(0)
  metadata          Json?              @default("{}")
  cover_url         String?            @db.VarChar(255)
  description       String?
  book_type         String             @default("pdf_book") @db.VarChar(255)
  pages               pages[]
  reading_progress    reading_progress[]
  scenes              scenes[]
  book_pronunciations book_pronunciations[]

  @@index([author(ops: raw("gin_trgm_ops"))], map: "books_author_gin_idx", type: Gin)
  @@index([is_published], map: "books_is_published_index")
  @@index([is_published, updated_at], map: "books_is_published_updated_at_index")
  @@index([metadata], map: "books_metadata_index", type: Gin)
  @@index([processing_status], map: "books_processing_status_index")
  @@index([source_type], map: "books_source_type_index")
  @@index([title(ops: raw("gin_trgm_ops"))], map: "books_title_gin_idx", type: Gin)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model oban_jobs {
  id           BigInt         @id @default(autoincrement())
  state        oban_job_state @default(available)
  queue        String         @default("default")
  worker       String
  args         Json           @default("{}")
  errors       Json[]         @default([])
  attempt      Int            @default(0)
  max_attempts Int            @default(20)
  inserted_at  DateTime       @default(dbgenerated("timezone('UTC'::text, now())")) @db.Timestamp(6)
  scheduled_at DateTime       @default(dbgenerated("timezone('UTC'::text, now())")) @db.Timestamp(6)
  attempted_at DateTime?      @db.Timestamp(6)
  completed_at DateTime?      @db.Timestamp(6)
  attempted_by String[]
  discarded_at DateTime?      @db.Timestamp(6)
  priority     Int            @default(0)
  tags         String[]       @default([])
  meta         Json?          @default("{}")
  cancelled_at DateTime?      @db.Timestamp(6)

  @@index([args], map: "oban_jobs_args_index", type: Gin)
  @@index([meta], map: "oban_jobs_meta_index", type: Gin)
  @@index([state, queue, priority, scheduled_at, id], map: "oban_jobs_state_queue_priority_scheduled_at_id_index")
}

model oban_peers {
  name       String   @id
  node       String
  started_at DateTime @db.Timestamp(6)
  expires_at DateTime @db.Timestamp(6)
}

model pages {
  id                      BigInt                    @id @default(autoincrement())
  book_id                 BigInt
  page_number             Int
  text_content            String?
  inserted_at             DateTime                  @db.Timestamp(0)
  updated_at              DateTime                  @db.Timestamp(0)
  scene_id                BigInt?
  image_url               String?                   @db.VarChar(255)
  narration_url           String?                   @db.VarChar(255)
  narration_timestamps    Json?
  word_pronunciations     Json?
  illustration_prompt     String?
  text_overlay            Json?
  composited_image_url    String?                   @db.VarChar(500)
  composited_image_path   String?                   @db.VarChar(500)
  composited_at           DateTime?                 @db.Timestamp(0)
  composited_by           String?                   @db.VarChar(255)
  books                   books                     @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  scenes                  scenes?                   @relation(fields: [scene_id], references: [id], onUpdate: NoAction)
  page_audio_assignments       page_audio_assignments[]
  page_overlay_narrations      page_overlay_narrations[]
  page_overlay_text_entries    page_overlay_text_entries[]

  @@unique([book_id, page_number], map: "pages_book_id_page_number_index")
  @@index([book_id], map: "pages_book_id_index")
  @@index([scene_id], map: "pages_scene_id_index")
  @@index([composited_image_url], map: "pages_composited_image_url_index")
}

model book_pronunciations {
  id                 BigInt    @id @default(autoincrement())
  book_id            BigInt
  normalized_word    String    @db.VarChar(255)
  display_word       String?   @db.VarChar(255)
  phonetic_display   String?
  syllables          Json?
  breakdown_segments Json?
  full_word_url      String?   @db.VarChar(500)
  breakdown_url      String?   @db.VarChar(500)
  source             String    @default("tts") @db.VarChar(32)
  status             String    @default("generated") @db.VarChar(32)
  confidence         Float?
  human_reviewed     Boolean   @default(false)
  generated_at       DateTime? @db.Timestamp(0)
  reviewed_at        DateTime? @db.Timestamp(0)
  created_at         DateTime  @default(now()) @db.Timestamp(0)
  updated_at         DateTime  @updatedAt @db.Timestamp(0)
  books              books     @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([book_id, normalized_word], map: "book_pronunciations_book_id_normalized_word_idx")
  @@index([book_id], map: "book_pronunciations_book_id_idx")
  @@index([human_reviewed], map: "book_pronunciations_human_reviewed_idx")
  @@index([book_id, status], map: "book_pronunciations_book_id_status_idx")
}

model page_audio_assignments {
  id          BigInt   @id @default(autoincrement())
  page_id     BigInt
  audio_url   String   @db.VarChar(255)
  audio_type  String   @db.VarChar(50)
  scope       String   @db.VarChar(50)
  range_start Int?
  range_end   Int?
  volume      Float?
  inserted_at DateTime @db.Timestamp(0)
  updated_at  DateTime @db.Timestamp(0)

  pages pages @relation(fields: [page_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([page_id], map: "page_audio_assignments_page_id_index")
  @@index([audio_type], map: "page_audio_assignments_audio_type_index")
}

model page_overlay_narrations {
  id                  BigInt   @id @default(autoincrement())
  page_id             BigInt
  overlay_element_id  String   @db.VarChar(255)
  voice_id            String   @db.VarChar(255)
  voice_name          String?  @db.VarChar(255)
  text_content        String
  audio_url           String   @db.VarChar(500)
  word_timestamps     Json?
  word_pronunciations Json?
  sort_order          Int      @default(0)
  inserted_at         DateTime @db.Timestamp(0)
  updated_at          DateTime @db.Timestamp(0)

  pages pages @relation(fields: [page_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([page_id, overlay_element_id, voice_id], map: "page_overlay_narrations_page_element_voice_idx")
  @@index([page_id], map: "page_overlay_narrations_page_id_idx")
  @@index([voice_id], map: "page_overlay_narrations_voice_id_idx")
}

model page_overlay_text_entries {
  id                   BigInt   @id @default(autoincrement())
  page_id              BigInt
  text_content         String
  include_in_narration Boolean  @default(true)
  sort_order           Int      @default(0)
  bbox                 Json?
  confidence           Float?
  source               String   @default("ocr") @db.VarChar(32)
  inserted_at          DateTime @db.Timestamp(0)
  updated_at           DateTime @db.Timestamp(0)

  pages pages @relation(fields: [page_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([page_id], map: "page_overlay_text_entries_page_id_idx")
  @@index([page_id, sort_order], map: "page_overlay_text_entries_page_sort_idx")
}

model reading_progress {
  id           BigInt    @id @default(autoincrement())
  user_id      BigInt
  book_id      BigInt
  current_page Int       @default(1)
  last_read_at DateTime? @db.Timestamp(0)
  inserted_at  DateTime  @db.Timestamp(0)
  updated_at   DateTime  @db.Timestamp(0)
  books        books     @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, book_id], map: "reading_progress_user_id_book_id_index")
  @@index([book_id], map: "reading_progress_book_id_index")
  @@index([user_id], map: "reading_progress_user_id_index")
}

model scenes {
  id           BigInt        @id @default(autoincrement())
  book_id      BigInt
  start_page   Int
  end_page     Int
  descriptors  Json?         @default("{}")
  inserted_at  DateTime      @db.Timestamp(0)
  updated_at   DateTime      @db.Timestamp(0)
  scene_number Int?
  pages        pages[]
  books        books         @relation(fields: [book_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  soundscapes  soundscapes[]

  @@index([book_id], map: "scenes_book_id_index")
  @@index([book_id, scene_number], map: "scenes_book_id_scene_number_index")
  @@index([book_id, start_page, end_page], map: "scenes_book_id_start_page_end_page_index")
}

model schema_migrations {
  version     BigInt    @id
  inserted_at DateTime? @db.Timestamp(0)
}

model soundscapes {
  id                BigInt   @id @default(autoincrement())
  scene_id          BigInt?
  audio_url         String   @db.VarChar(255)
  source_type       String   @default("curated") @db.VarChar(255)
  confidence_score  Float?
  admin_approved    Boolean  @default(false)
  inserted_at       DateTime @db.Timestamp(0)
  updated_at        DateTime @db.Timestamp(0)
  generation_prompt String?
  tags              String[] @default([]) @db.VarChar(255)
  scenes            scenes?  @relation(fields: [scene_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([admin_approved], map: "soundscapes_admin_approved_index")
  @@index([generation_prompt(ops: raw("gin_trgm_ops"))], map: "soundscapes_generation_prompt_gin_idx", type: Gin)
  @@index([scene_id], map: "soundscapes_scene_id_index")
  @@index([source_type], map: "soundscapes_source_type_index")
  @@index([tags], map: "soundscapes_tags_gin_idx", type: Gin)
}

model users {
  id                  BigInt             @id @default(autoincrement())
  email               String             @unique(map: "users_email_index") @db.VarChar(255)
  password_hash       String             @db.VarChar(255)
  subscription_tier   String             @default("free") @db.VarChar(255)
  stripe_customer_id  String?            @db.VarChar(255)
  subscription_status String?            @db.VarChar(255)
  role                String             @default("user") @db.VarChar(255)
  inserted_at         DateTime           @db.Timestamp(0)
  updated_at          DateTime           @db.Timestamp(0)
  reading_progress    reading_progress[]
  users_tokens        users_tokens[]

  @@index([role], map: "users_role_index")
}

model users_tokens {
  id          BigInt   @id @default(autoincrement())
  user_id     BigInt
  token       Bytes
  context     String   @db.VarChar(255)
  sent_to     String?  @db.VarChar(255)
  inserted_at DateTime @db.Timestamp(0)
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([context, token], map: "users_tokens_context_token_index")
  @@index([user_id], map: "users_tokens_user_id_index")
}

// Better Auth Core Tables
model user {
  id                    String                    @id @default(cuid())
  name                  String
  email                 String                    @unique
  emailVerified         Boolean                   @default(false)
  image                 String?
  role                  String                    @default("user")
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  sessions              session[]
  accounts              account[]
  reader_feedback       reader_feedback[]
  user_reading_progress user_reading_progress[]
  child_profiles        child_profile[]
  mobileAnalyticsEvents mobile_analytics_events[]
}

model session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model reader_feedback {
  id        String   @id @default(cuid())
  userId    String
  rating    Int // 1-5 stars
  feedback  String? // Optional text feedback (max 200 chars)
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model user_reading_progress {
  id          String   @id @default(cuid())
  userId      String
  bookId      BigInt
  currentPage Int      @default(1)
  totalPages  Int
  lastReadAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@index([lastReadAt])
}

model child_profile {
  id           String   @id @default(cuid())
  userId       String
  displayName  String
  ageBand      String
  readingLevel String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user                  user                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookProgress          child_book_progress[]
  readingSessions       reading_session[]
  questionAttempts      question_attempt[]
  mobileAnalyticsEvents mobile_analytics_events[]

  @@index([userId])
}

model child_book_progress {
  id              String    @id @default(cuid())
  childProfileId  String
  bookId          BigInt
  currentPage     Int       @default(1)
  totalPages      Int
  lastReadAt      DateTime
  completedAt     DateTime?
  completionCount Int       @default(0)
  lastSessionId   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  childProfile child_profile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@unique([childProfileId, bookId])
  @@index([childProfileId])
  @@index([bookId])
}

model reading_session {
  id               String   @id @default(cuid())
  sessionId        String   @unique
  userId           String
  childProfileId   String
  bookId           BigInt
  startedAt        DateTime
  endedAt          DateTime
  durationSeconds  Int
  startPage        Int
  endPage          Int
  entryIntent      String   @default("standard")
  usedNarration    Boolean  @default(false)
  usedPracticeMode Boolean  @default(false)
  completedBook    Boolean  @default(false)
  source           String   @default("mobile")
  metadata         Json?    @default("{}")
  createdAt        DateTime @default(now())

  childProfile child_profile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@index([childProfileId, startedAt])
  @@index([bookId, startedAt])
  @@index([userId])
}

model book_question {
  id            String   @id @default(cuid())
  bookId        BigInt
  questionText  String
  questionType  String   @default("multiple_choice")
  sortOrder     Int
  correctAnswer String
  metadata      Json?    @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  options  book_question_option[]
  attempts question_attempt[]

  @@index([bookId, sortOrder])
}

model book_question_option {
  id         String @id @default(cuid())
  questionId String
  optionKey  String
  optionText String
  sortOrder  Int    @default(0)

  question book_question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model question_attempt {
  id               String   @id @default(cuid())
  userId           String
  childProfileId   String
  bookId           BigInt
  questionId       String
  readingSessionId String?
  selectedAnswer   String
  isCorrect        Boolean
  answeredAt       DateTime @default(now())

  childProfile child_profile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  question     book_question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([childProfileId, bookId, answeredAt])
  @@index([questionId])
}

model mobile_analytics_events {
  id               String   @id
  user_id          String
  child_profile_id String
  book_id          BigInt?
  session_id       String?
  event_name       String
  source           String   @default("mobile")
  properties       Json?    @default("{}")
  occurred_at      DateTime @default(now())
  created_at       DateTime @default(now())

  user          user          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  child_profile child_profile @relation(fields: [child_profile_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "mobile_analytics_events_user_id_idx")
  @@index([child_profile_id], map: "mobile_analytics_events_child_profile_id_idx")
  @@index([book_id], map: "mobile_analytics_events_book_id_idx")
  @@index([session_id], map: "mobile_analytics_events_session_id_idx")
  @@index([event_name], map: "mobile_analytics_events_event_name_idx")
  @@index([child_profile_id, occurred_at], map: "mobile_analytics_events_child_profile_id_occurred_at_idx")
  @@index([user_id, occurred_at], map: "mobile_analytics_events_user_id_occurred_at_idx")
}

enum oban_job_state {
  available
  scheduled
  executing
  retryable
  completed
  discarded
  cancelled
}
