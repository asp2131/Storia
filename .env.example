# Local development defaults for Loratone web.
# Copy or symlink to .env.local and .env. bin/bootstrap.sh does this automatically
# when no local env file is present.

# Local Docker Postgres from npm run db:up / scripts/ensure-local-db.sh
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/storia_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/storia_dev?schema=public"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase client/server values. Leave blank until using storage/auth flows.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="storia-storage"

# Optional soundscape overrides.
SUPABASE_SOUNDSCAPE_BUCKET="storia-storage"
SUPABASE_SOUNDSCAPE_BASE_PATH="audio/curated"
NEXT_PUBLIC_SUPABASE_SOUNDSCAPE_BUCKET="storia-storage"
NEXT_PUBLIC_SUPABASE_SOUNDSCAPE_BASE_PATH="audio/curated"

# Optional AI/email integrations.
REPLICATE_API_TOKEN=""
REPLICATE_KEY=""
ELEVENLABS_API_KEY=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Loratone <onboarding@resend.dev>"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional analytics.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
NEXT_PUBLIC_UMAMI_URL="https://cloud.umami.is/script.js"
